---
import { site } from "../config/site";

interface Props {
  lastUpdated: string;
  editionLabel: string;
  isDemo: boolean;
  regulationYear: number;
  regulationStatus: "provisional" | "official";
}

const { lastUpdated, editionLabel, isDemo, regulationYear, regulationStatus } = Astro.props;
const updatedLabel = new Intl.DateTimeFormat("es-PY", {
  dateStyle: "short",
  timeStyle: "short",
  timeZone: "America/Asuncion",
}).format(new Date(lastUpdated));
---

<header class="event-header">
  <div class="event-header__topline">
    <a class="brand" href="/" aria-label={`${site.name}, inicio`}>
      <span class="brand__mark" aria-hidden="true">U</span>
      <span>{site.name}</span>
    </a>
    <span class="event-header__edition">{editionLabel}</span>
  </div>
  <div class="event-header__content">
    <div>
      <p class="eyebrow">Resultados generales</p>
      <h1>{site.name}</h1>
      <p class="event-header__dates">Clasificación por disciplinas, ramas y modalidades.</p>
    </div>
    <p class="last-updated">
      <span class="last-updated__dot" aria-hidden="true"></span>
      <span>Última actualización</span>
      <time datetime={lastUpdated}>{updatedLabel}</time>
    </p>
  </div>
  <p class:list={["regulation-notice", regulationStatus === "provisional" && "regulation-notice--provisional"]}>
    Reglamento base {regulationYear} {regulationStatus === "provisional" ? "· pendiente de confirmación para esta edición" : "· vigente"}
    {isDemo && " · datos de demostración"}
  </p>
</header>
