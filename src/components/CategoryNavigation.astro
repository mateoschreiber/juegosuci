---
import RankingTable from "./RankingTable.astro";
import TeamBadge from "./TeamBadge.astro";
import { createCategoryRanking, hasPublishedScores } from "../lib/ranking";
import type { Category, Team } from "../types/games";

interface Props {
  categories: Category[];
  teams: Team[];
}

const { categories, teams } = Astro.props;
const labels = {
  pending: "Próximamente",
  in_progress: "En curso",
  completed: "Finalizado",
} as const;
---

<section class="categories" aria-labelledby="categories-title" data-category-navigation>
  <div class="section-heading">
    <p class="eyebrow">Por deporte</p>
    <h2 id="categories-title">Clasificación y resultados</h2>
  </div>

  <nav class="category-scroller" aria-label="Ver clasificación por deporte">
    <a class="category-chip category-chip--general" href="#clasificacion-general" data-general-link aria-current="page">General</a>
    {
      categories.map((category) => (
        <button
          class="category-chip"
          type="button"
          data-category-toggle={category.id}
          aria-controls={`category-${category.id}`}
          aria-expanded="false"
        >
          {category.name}
        </button>
      ))
    }
  </nav>

  <div class="category-panels">
    {
      categories.map((category) => {
        const ranking = createCategoryRanking(category, teams);
        return (
          <article class="category-panel" id={`category-${category.id}`} data-category-panel={category.id} aria-labelledby={`category-title-${category.id}`}>
            <div class="category-panel__header">
              <div>
                <p class="eyebrow">{labels[category.status]}</p>
                <h3 id={`category-title-${category.id}`}>{category.name}</h3>
              </div>
              <span class:list={["status", `status--${category.status}`]}>{labels[category.status]}</span>
            </div>

            {
              hasPublishedScores(category) ? (
                <RankingTable ranking={ranking} caption={`Clasificación de ${category.name}`} />
              ) : (
                <p class="empty-state">Todavía no se publicaron puntajes para esta categoría.</p>
              )
            }

            {
              category.results.length > 0 && (
                <div class="results" aria-label={`Resultados de ${category.name}`}>
                  <h4>Resultados relevantes</h4>
                  <ul class="results__list">
                    {category.results.map((result) => (
                      <li>
                        <div>
                          <strong>{result.title}</strong>
                          <p>{result.summary}</p>
                        </div>
                        {
                          result.teamIds && result.teamIds.length > 0 && (
                            <div class="results__teams">
                              {result.teamIds.map((teamId) => {
                                const team = teams.find((candidate) => candidate.id === teamId);
                                return team && <TeamBadge team={team} />;
                              })}
                            </div>
                          )
                        }
                      </li>
                    ))}
                  </ul>
                </div>
              )
            }
          </article>
        );
      })
    }
  </div>
</section>

<script>
  const navigation = document.querySelector<HTMLElement>("[data-category-navigation]");

  if (navigation) {
    const panels = Array.from(navigation.querySelectorAll<HTMLElement>("[data-category-panel]"));
    const buttons = Array.from(navigation.querySelectorAll<HTMLButtonElement>("[data-category-toggle]"));
    const generalLink = navigation.querySelector<HTMLAnchorElement>("[data-general-link]");

    const showGeneral = () => {
      panels.forEach((panel) => { panel.hidden = true; });
      buttons.forEach((button) => { button.setAttribute("aria-expanded", "false"); });
      generalLink?.setAttribute("aria-current", "page");
    };

    const showCategory = (id: string) => {
      panels.forEach((panel) => { panel.hidden = panel.dataset.categoryPanel !== id; });
      buttons.forEach((button) => {
        button.setAttribute("aria-expanded", String(button.dataset.categoryToggle === id));
      });
      generalLink?.removeAttribute("aria-current");
    };

    showGeneral();

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const id = button.dataset.categoryToggle;
        if (id) showCategory(id);
      });
    });

    generalLink?.addEventListener("click", () => showGeneral());
  }
</script>
