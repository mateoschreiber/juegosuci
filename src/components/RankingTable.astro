---
import TeamBadge from "./TeamBadge.astro";
import type { AwardedPlacement, RankedFaculty } from "../types/edition";

interface Props {
  ranking: Array<RankedFaculty | AwardedPlacement>;
  caption: string;
  showResult?: boolean;
  showAdjustment?: boolean;
}

const { ranking, caption, showResult = false, showAdjustment = false } = Astro.props;
---

<div class="ranking-table-wrap">
  <table class="ranking-table">
    <caption>{caption}</caption>
    <thead>
      <tr>
        <th scope="col" class="ranking-table__position">Pos.</th>
        <th scope="col">Facultad</th>
        {showResult && <th scope="col" class="ranking-table__result">Resultado</th>}
        {showAdjustment && <th scope="col" class="ranking-table__adjustment">Ajuste</th>}
        <th scope="col" class="ranking-table__points">Puntos</th>
      </tr>
    </thead>
    <tbody>
      {
        ranking.map((entry) => (
          <tr class:list={["ranking-table__row", entry.position <= 3 && "ranking-table__row--top"]}>
            <th scope="row" class="ranking-table__position">
              <span>{entry.position}°</span>
              {entry.isTied && <span class="sr-only">, empate</span>}
            </th>
            <td><TeamBadge team={entry.faculty} /></td>
            {showResult && <td class="ranking-table__result">{"result" in entry ? entry.result ?? "-" : "-"}</td>}
            {showAdjustment && <td class:list={["ranking-table__adjustment", "adjustmentPoints" in entry && entry.adjustmentPoints < 0 && "ranking-table__adjustment--negative"]}>{"adjustmentPoints" in entry && entry.adjustmentPoints !== 0 ? entry.adjustmentPoints : "-"}</td>}
            <td class="ranking-table__points">{"netPoints" in entry ? entry.netPoints : entry.points}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
