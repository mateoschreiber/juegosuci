---
import RankingTable from "./RankingTable.astro";
import { createAthleticsInternalRanking, createAwardedPlacements } from "../lib/ranking";
import type { CompetitionStatus, EditionData } from "../types/edition";

interface Props {
  edition: EditionData;
}

const { edition } = Astro.props;
const labels: Record<CompetitionStatus, string> = {
  not_started: "Próximamente",
  in_progress: "En curso",
  official: "Oficial",
  disabled: "Pendiente",
};
---

<section class="disciplines" aria-labelledby="disciplines-title" data-discipline-groups>
  <div class="section-heading">
    <p class="eyebrow">Resultados</p>
    <h2 id="disciplines-title">Disciplinas y modalidades</h2>
  </div>
  <nav class="group-selector" aria-label="Ver grupo de disciplinas">
    {
      edition.groups.map((group, index) => (
        <button class="group-selector__button" type="button" data-group-toggle={group.id} aria-controls={`group-${group.id}`} aria-pressed={index === 0 ? "true" : "false"}>
          {group.name}
        </button>
      ))
    }
  </nav>
  <div class="group-panels">
    {
      edition.groups.map((group, index) => (
        <section class="group-panel" id={`group-${group.id}`} data-group-panel={group.id} aria-labelledby={`group-title-${group.id}`} hidden={index !== 0}>
          <p class="group-panel__intro" id={`group-title-${group.id}`}>{group.description}</p>
          <div class="discipline-list">
            {
              group.disciplines.map((discipline) => {
                const awards = discipline.format === "ranked"
                  ? createAwardedPlacements(edition, discipline.status === "official" ? discipline.placements ?? [] : [], discipline.profileId)
                  : [];
                const athleticsRanking = discipline.format === "athletics" ? createAthleticsInternalRanking(edition, discipline) : [];
                return (
                  <article class="discipline-card">
                    <div class="discipline-card__heading">
                      <div>
                        <h3>{discipline.name}</h3>
                        {(discipline.branch || discipline.mode) && <p>{[discipline.branch, discipline.mode].filter(Boolean).join(" · ")}</p>}
                      </div>
                      <span class:list={["status", `status--${discipline.status}`]}>{labels[discipline.status]}</span>
                    </div>
                    {discipline.note && <p class="discipline-card__note">{discipline.note}</p>}
                    {
                      discipline.format === "ranked" ? (
                        awards.length > 0 ? <RankingTable ranking={awards} caption={`Resultados de ${discipline.name}`} showResult /> : <p class="empty-state">Aún no hay posiciones oficiales publicadas.</p>
                      ) : (
                        <>
                          <p class="discipline-card__note">Puntaje interno provisional. No se agrega a la clasificación general hasta publicar el cierre de atletismo.</p>
                          <RankingTable ranking={athleticsRanking} caption="Clasificación interna provisional de atletismo" />
                          <details class="athletics-events">
                            <summary>Ver pruebas de atletismo</summary>
                            <ul>
                              {(discipline.athleticsEvents ?? []).map((event) => (
                                <li>
                                  <span>{event.name} · {event.branch}</span>
                                  <strong>{labels[event.status]}</strong>
                                </li>
                              ))}
                            </ul>
                          </details>
                        </>
                      )
                    }
                  </article>
                );
              })
            }
          </div>
        </section>
      ))
    }
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-discipline-groups]");
  if (root) {
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-group-toggle]"));
    const panels = Array.from(root.querySelectorAll<HTMLElement>("[data-group-panel]"));
    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const id = button.dataset.groupToggle;
        panels.forEach((panel) => { panel.hidden = panel.dataset.groupPanel !== id; });
        buttons.forEach((candidate) => candidate.setAttribute("aria-pressed", String(candidate === button)));
      });
    });
  }
</script>
